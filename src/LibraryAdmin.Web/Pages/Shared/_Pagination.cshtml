@model LibraryAdmin.Web.Models.PaginationView
@if (Model.TotalPages > 1)
{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, start + 4);
    start = Math.Max(1, end - 4);

    <nav aria-label="分页">
        <ul class="pagination justify-content-center mt-4 mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-page="@Model.PageName"
                   asp-route-pageNumber="@(Model.Page - 1)"
                   asp-route-query="@Model.Query"
                   asp-route-status="@Model.Status"
                   asp-route-includeArchived="@Model.IncludeArchived">上一页</a>
            </li>
            @for (var number = start; number <= end; number++)
            {
                <li class="page-item @(number == Model.Page ? "active" : "")">
                    <a class="page-link" asp-page="@Model.PageName"
                       asp-route-pageNumber="@number"
                       asp-route-query="@Model.Query"
                       asp-route-status="@Model.Status"
                       asp-route-includeArchived="@Model.IncludeArchived">@number</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="@Model.PageName"
                   asp-route-pageNumber="@(Model.Page + 1)"
                   asp-route-query="@Model.Query"
                   asp-route-status="@Model.Status"
                   asp-route-includeArchived="@Model.IncludeArchived">下一页</a>
            </li>
        </ul>
    </nav>
}
