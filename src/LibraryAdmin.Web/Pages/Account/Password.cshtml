@page
@model LibraryAdmin.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "修改密码";
}

<div class="auth-shell">
    <section class="surface auth-card">
        <div class="eyebrow">Security</div>
        <h1 class="mb-2">修改登录密码</h1>
        <p class="muted mb-4">新密码至少 8 个字符。初始密码提示可以选择稍后修改。</p>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert @(Model.StatusMessage.Contains("已修改") ? "alert-success" : "alert-danger")">@Model.StatusMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Input.CurrentPassword" class="form-label">当前密码</label>
                <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label">新密码</label>
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label">确认新密码</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">修改密码</button>
        </form>

        @if (User.MustChangePassword())
        {
            <form method="post" asp-page-handler="Skip" class="mt-3">
                <button type="submit" class="btn btn-link w-100 text-secondary">稍后修改</button>
            </form>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
